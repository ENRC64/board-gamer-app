rules_version = '2';

// Security Rules v1 (T-28). Grundsatz: nur angemeldete Mitglieder der
// (einzigen) Gruppe lesen; geschrieben wird nur mit der eigenen Nutzer-ID.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Felder, die nur der Gastgeber eines Termins ändern darf.
    function hostOnlyFields() {
      return ['status', 'hostId', 'hostName', 'date', 'address'];
    }

    // Lebenszyklus planned → active → completed (A-06), nur eine Stufe vor.
    function validStatusChange(before, after) {
      return before == after
        || (before == 'planned' && after == 'active')
        || (before == 'active' && after == 'completed');
    }

    // ---------- Profile ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if false;
    }

    // ---------- Spielvorschaelge ----------
    
    // Inhaltliche Prüfung eines neuen Spielvorschlags (US-03, A-07):
    // genau diese Felder, Titel 1 bis 140 Zeichen, positive Spielerzahlen,
    // min <= max, Erstellungszeit als Timestamp.
    function validSuggestion(data) {
      return data.keys().hasOnly(
          ['title', 'description', 'minPlayers', 'maxPlayers', 'userId',
           'createdAt'])
        && data.keys().hasAll(
          ['title', 'description', 'minPlayers', 'maxPlayers', 'userId',
           'createdAt'])
        && data.title is string
        && data.title.trim().size() > 0
        && data.title == data.title.trim()
        && data.title.size() <= 140
        && data.description is string
        && data.userId is string
        && data.minPlayers is int
        && data.maxPlayers is int
        && data.minPlayers > 0
        && data.minPlayers <= data.maxPlayers
        && data.createdAt is timestamp;
    }
    
    match /gameSuggestions/{suggestionId} {
      allow read: if signedIn();
      allow create: if validSuggestion(request.resource.data)
        && isSelf(request.resource.data.userId)
        && request.resource.data.createdAt == request.time;
      allow update: if isSelf(resource.data.userId)
        && validSuggestion(request.resource.data)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['title', 'description', 'minPlayers', 'maxPlayers']);
      allow delete: if isSelf(resource.data.userId);      
    }

    // ---------- Spielvorschaelge ----------



    // ---------- Spieltermine ----------
    match /events/{eventId} {
      allow read: if signedIn();

      // Neuer Termin startet immer mit Status planned, und man kann ihn nur
      // für sich selbst als Gastgeber anlegen (A-04, A-05).
      allow create: if signedIn()
        && request.resource.data.status == 'planned'
        && request.resource.data.hostId == request.auth.uid;

      // Gastgeber: alles, aber nur gültige Statuswechsel.
      // Andere Mitglieder: nur Felder, die nicht dem Gastgeber vorbehalten sind.
      allow update: if signedIn() && (
        (request.auth.uid == resource.data.hostId
          && validStatusChange(resource.data.status,
                               request.resource.data.status))
        || !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(hostOnlyFields())
      );

      // Absage = Löschen, nur durch den Gastgeber und nur solange geplant (A-06).
      allow delete: if signedIn()
        && request.auth.uid == resource.data.hostId
        && resource.data.status == 'planned';

      // Unterkollektionen (Votes, Reviews, Statusmeldungen, Vorschläge,
      // Bestellungen): Schreiben nur mit eigener Nutzer-ID, entweder als
      // Dokument-ID (z. B. Review, Essens-Vote) oder im Feld userId.
      match /{subcollection}/{docId} {
        allow read: if signedIn();
        allow create: if signedIn() && (
          docId == request.auth.uid
          || request.resource.data.userId == request.auth.uid
        );
        allow update, delete: if signedIn() && (
          docId == request.auth.uid
          || resource.data.userId == request.auth.uid
        );
      }
    }
  }
}
